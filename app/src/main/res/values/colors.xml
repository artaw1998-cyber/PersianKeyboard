<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="kb_bg">#263238</color>
    <color name="key_bg">#37474F</color>
    <color name="key_text">#ECEFF1</color>
    <color name="suggestion_bg">#1E262B</color>
    <color name="special_key">#1E262B</color>

    <!-- استایل دکمه‌های عادی -->
    <style name="KeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/key_bg_normal</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- استایل دکمه‌های خاص (مثل فاصله و اینتر) -->
    <style name="KeyStyleSpecial">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/key_bg_special</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    
    <!-- استایل دکمه‌های پنجره اعراب -->
    <style name="DiacriticStyle">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
