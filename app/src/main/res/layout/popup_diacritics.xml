<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="8dp"
    android:elevation="8dp">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/diacritic_fatha" style="@style/DiacriticStyle" android:text="َ" />
        <TextView android:id="@+id/diacritic_kasra" style="@style/DiacriticStyle" android:text="ِ" />
        <TextView android:id="@+id/diacritic_damma" style="@style/DiacriticStyle" android:text="ُ" />
        <TextView android:id="@+id/diacritic_shadda" style="@style/DiacriticStyle" android:text="ّ" />
        <TextView android:id="@+id/diacritic_sukun" style="@style/DiacriticStyle" android:text="ْ" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/diacritic_fathatan" style="@style/DiacriticStyle" android:text="ً" />
        <TextView android:id="@+id/diacritic_kasratan" style="@style/DiacriticStyle" android:text="ٍ" />
        <TextView android:id="@+id/diacritic_dammatan" style="@style/DiacriticStyle" android:text="ٌ" />
        <TextView android:id="@+id/diacritic_alef_kh" style="@style/DiacriticStyle" android:text="ٰ" />
        <TextView android:id="@+id/btn_close_popup" style="@style/DiacriticStyle" android:text="✖" android:textSize="16sp" android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
